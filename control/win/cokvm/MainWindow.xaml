<Window x:Class="CoKVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CoKVM.UI.Controls"
        Title="CoKVM">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <controls:VideoView x:Name="VideoView" Grid.Row="0"/>
        <controls:StatusBarView x:Name="StatusBar" Grid.Row="1"/>
    </Grid>
</Window>