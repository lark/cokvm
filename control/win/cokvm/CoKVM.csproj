<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CoKVM</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsPackageType>MSIX</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml and *.xaml pages are auto-included by the WinUI SDK targets
         (EnableDefaultApplicationDefinition / EnableDefaultPageItems). Do not
         declare them explicitly or you get NETSDK1022 duplicate-item errors. -->
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Self-contained isn't required; build from Visual Studio 2022 (Windows App SDK
    workload). VS auto-creates a dev certificate for MSIX signing. To build from
    CLI, set <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled> for an
    unpackaged build.
  -->
</Project>