<UserControl x:Class="CoKVM.UI.Controls.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30"
             Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">

    <UserControl.Resources>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Padding="10,0,10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/> <!-- CapsLock -->
            <ColumnDefinition Width="Auto"/> <!-- Video -->
            <ColumnDefinition Width="Auto"/> <!-- Bluetooth -->
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ViewportLabel" Grid.Column="0" Style="{StaticResource StatusLabel}" Text="---" Margin="0,0,15,0"/>
        <TextBlock x:Name="MouseLabel"    Grid.Column="1" Style="{StaticResource StatusLabel}" Text="---" Margin="0,0,15,0"/>
        <TextBlock x:Name="KeyboardLabel" Grid.Column="2" Style="{StaticResource StatusLabel}" Text="---" Margin="0,0,15,0"/>

        <!-- Caps Lock indicator (plain text label — no icon-font licensing concerns) -->
        <TextBlock x:Name="CapsLockLabel" Grid.Column="3" Style="{StaticResource StatusLabel}" Text="Caps" Margin="0,0,10,0"/>

        <!-- Video status button -->
        <Button x:Name="VideoButton" Grid.Column="4" Style="{StaticResource StatusButton}" Click="OnVideoClick" Margin="10,0,0,0">
            <FontIcon x:Name="VideoIcon" Glyph="&#xE714;" FontSize="14" Foreground="Gray"/>
        </Button>

        <!-- Bluetooth status button -->
        <Button x:Name="BluetoothButton" Grid.Column="5" Style="{StaticResource StatusButton}" Click="OnBluetoothClick" Margin="10,0,0,0">
            <FontIcon x:Name="BluetoothIcon" Glyph="&#xE702;" FontSize="14" Foreground="Gray"/>
        </Button>
    </Grid>
</UserControl>